# Copia a .env y llena. No subas .env al repo.
# HOST: solo el hostname, sin https:// y sin /sql/...
DATABRICKS_HOST=dbc-xxxxxxxx.cloud.databricks.com
# HTTP path: SQL Warehouse → (el warehouse) → Connection details → HTTP path
# Tiene que verse así, NO la URL del navegador:
DATABRICKS_HTTP_PATH=/sql/1.0/warehouses/xxxxxxxx
DATABRICKS_TOKEN=dapixxxxxxxx
GOLD_TABLE=workspace.default.silver_ventas
